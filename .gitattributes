# Normalise line endings so collaborators on Windows, macOS and Linux see the same files.
* text=auto eol=lf

# Binary outputs and data formats: never normalise.
*.png binary
*.pdf binary
*.nii binary
*.nii.gz binary
*.dcm binary
*.edf binary
*.fif binary
*.mat binary
*.xdf binary
*.h5 binary
*.nc binary
*.pkl binary
*.parquet binary
*.hex binary
*.zip binary
tests/fixtures/*.txt -text
bench/captures/*.txt -text
*.exe binary
*.avi binary
*.wav binary
*.HEIC binary
*.stl binary
control_panel/firmware/teensy_loader_cli binary
